# 可选：服务端默认接口。留空时，用户可在页面填写个人 API 设置。
OPENAI_API_KEY=
OPENAI_API_BASE_URL=

# 可选：生成、编辑和删除操作的访问密码。
APP_PASSWORD=

# 可选：fs 或 indexeddb。留空时本地使用 fs，Vercel 使用 indexeddb。
NEXT_PUBLIC_IMAGE_STORAGE_MODE=

# 可选：文件存储位置。默认是当前项目的 generated-images/。
IMAGE_STORAGE_DIR=

# 可选：历史图片目录。多个目录按系统路径分隔符分隔（Windows 为分号）。
LEGACY_IMAGE_STORAGE_DIRS=

# 可选：兼容服务商要求的请求 User-Agent。
OPENAI_API_USER_AGENT=
